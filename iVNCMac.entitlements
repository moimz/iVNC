<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iCloud 키-값 동기화(com.apple.developer.ubiquity-kvstore-identifier)는 맥용 프로필이 생긴 뒤 넣는다 (Ai/iVNC.md 14장) -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.moimz.iVNC</string>
	</array>
</dict>
</plist>
